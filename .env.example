# ==============================================================================
# DocuSphere AI - Environment Configuration Template
# Copy this file to .env and provide your specific credentials.
# ==============================================================================

# Flask Server Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=docusphere_super_secret_jwt_and_session_key_2026

# Storage Paths
DB_PATH=db/docusphere.db
UPLOAD_FOLDER=uploads
INDEX_FOLDER=indices

# LLM Provider Configuration (Groq / OpenAI compatible)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Embedding Model Configuration (Local SentenceTransformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# RAG & Hybrid Search Hyperparameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5
HYBRID_ALPHA=0.6              # 0.6 Dense Vector Weight, 0.4 Sparse BM25 Weight
MAX_VERIFICATION_ATTEMPTS=3   # Self-correcting loop limit
